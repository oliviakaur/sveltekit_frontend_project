{
  "name": "sveltekit-seo-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:node": "DEPLOY_TARGET=node vite build",
    "build:vercel": "DEPLOY_TARGET=vercel vite build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
    "build:netlify": "DEPLOY_TARGET=netlify vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/adapter-netlify": "^5.0.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/adapter-vercel": "^5.6.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}